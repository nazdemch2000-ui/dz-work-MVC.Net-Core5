@{
    ViewData["Title"] = "Всі товари";
}
@model IEnumerable<Product>

<h3 class="p-2 bg-primary text-white text-center">Товари</h3>

@{
    ViewBag.searches = new string[] { "Name", "Category.Name" };
    ViewBag.sorts = new string[] { "Name", "Category.Name", "PurchasePrice", "RetailPrice" };
}
<partial name="_PageOptions" model="Model" />

<div class="container">

    <div class="row">
        <div class="col fw-bold">Назва</div>
        <div class="col fw-bold">Категорія</div>
        <div class="col fw-bold">Закупівельна ціна</div>
        <div class="col fw-bold">Роздрібна ціна</div>
        <div class="col"></div>
    </div>

    @foreach (Product product in Model)
    {
        <div class="row p-2">
            <div class="col">@product.Name</div>
            <div class="col">@product.Category?.Name</div>
            <div class="col text-right">@product.PurchasePrice</div>
            <div class="col text-right">@product.RetailPrice</div>
            <div class="col">
                <form asp-action="DeleteProduct" method="post">
                    <input type="hidden" name="Id" value="@product.Id">
                    <a asp-action="UpdateProduct" asp-route-id="@product.Id" class="btn btn-outline-primary">Редагувати</a>
                    <button type="submit" class="btn btn-outline-danger">Видалити</button>
                </form>
            </div>
        </div>
    }

    <div class="text-center p-2">
        <a asp-action="UpdateProduct" asp-route-id="0" class="btn btn-primary">Додати</a>
        <a asp-action="UpdateAll" class="btn btn-secondary">Масове оновлення</a>
    </div>

</div>

<div class="text-center">
    <partial name="_Pages" model="Model" />
</div>

 