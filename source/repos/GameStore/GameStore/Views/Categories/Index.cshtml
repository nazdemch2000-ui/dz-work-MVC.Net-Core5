@{
    ViewData["Title"] = "Категорії";
}
@model IEnumerable<Category>

<h3 class="p-2 bg-primary text-white text-center">Категорії</h3>
<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-1 fw-bold">Id</div>
        <div class="col fw-bold">Назва</div>
        <div class="col fw-bold">Опис</div>
        <div class="col-3"></div>
    </div>

    @foreach (Category category in Model)
    {
        <div class="row p-2">
            <div class="col-1">@category.Id</div>
            <div class="col">@category.Name</div>
            <div class="col">@category.Description</div>
            <div class="col-3 text-right">
                <form asp-action="DeleteCategory" method="post">
                    <input type="hidden" name="Id" value="@category.Id">
                    <a asp-action="UpdateCategory" asp-route-id="@category.Id" class="btn btn-outline-primary">Редагувати</a>
                    <button type="submit" class="btn btn-outline-danger">Видалити</button>
                </form>
            </div>
        </div>
    }
</div>
<div class="text-center mt-3">
    <a asp-action="UpdateCategory" asp-route-id="0" class="btn btn-primary">Створити</a>
    <a asp-action="UpdateAll" class="btn btn-secondary">Масове оновлення</a>
</div>
