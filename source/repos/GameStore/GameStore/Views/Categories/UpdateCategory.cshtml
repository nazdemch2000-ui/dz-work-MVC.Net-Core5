@{
    ViewData["Title"] = "Створення / Оновлення категорії";
}
@model Category

<div class="p-5 text-center bg-light">
    <h2 class="mb-3">Створення / Оновлення категорії</h2>
</div>
<form asp-action="UpdateCategory" method="post">
    <div class="form-group">
        <label asp-for="Id"></label>
        <input asp-for="Id" class="form-control" readonly="readonly" />
    </div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
    </div>
    <div class="text-center">
        <button class="btn btn-primary" type="submit">Зберегти</button>
        <a asp-action="Index" class="btn btn-secondary">Скасування</a>
    </div>
</form>
