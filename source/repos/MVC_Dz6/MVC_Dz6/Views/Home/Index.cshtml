@model IEnumerable<MVC_Dz6.Models.User>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-4">
    <h1 class="display-4">Registered users</h1>
    <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Register new user</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        No users yet. Click "Register new user" to add the first one.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>First name</th>
                <th>Last name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Age</th>
                <th>Website</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@user.PhoneNumber</td>
                    <td>@user.Age</td>
                    <td>
                        @if (!string.IsNullOrEmpty(user.Website))
                        {
                            <a href="@user.Website" target="_blank" rel="noopener">@user.Website</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
