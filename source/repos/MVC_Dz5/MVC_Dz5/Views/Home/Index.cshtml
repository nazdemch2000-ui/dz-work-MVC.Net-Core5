@model IEnumerable<MVC_Dz5.Models.Book>
@{
    ViewData["Title"] = "Каталог книг";
}

<div class="container py-4">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold">Каталог книг</h1>
        <p class="text-muted">Оберіть книгу, щоб переглянути деталі та залишити коментар</p>
    </div>
    <div class="d-flex justify-content-end mb-4">
        <a asp-action="Create" class="btn btn-success">+ Створити книгу</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">Поки що немає книг у каталозі.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var book in Model)
            {
                var cover = book.Images.FirstOrDefault()?.Url;
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        @if (cover != null)
                        {
                            <img src="@cover" class="card-img-top" alt="@book.Title"
                                 style="height: 280px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light text-muted"
                                 style="height: 280px;">
                                Немає обкладинки
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <span class="badge rounded-pill text-bg-secondary align-self-start mb-2">@book.Genre</span>
                            <h5 class="card-title mb-1">@book.Title</h5>
                            <p class="card-text text-muted mb-3">@book.Author</p>
                            <div class="mt-auto d-flex align-items-center justify-content-between">
                                <span class="fs-5 fw-bold text-success">@book.Price.ToString("0.00") грн</span>
                                <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-primary btn-sm">
                                    Детальніше
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
