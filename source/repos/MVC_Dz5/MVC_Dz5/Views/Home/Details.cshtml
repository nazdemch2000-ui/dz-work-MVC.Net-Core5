@model MVC_Dz5.Models.Book
@{
    ViewData["Title"] = "Деталі книги";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-link px-0">&larr; До каталогу</a>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Редагувати</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Видалити</a>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            @if (Model.Images.Any())
            {
                <div id="bookCarousel" class="carousel slide rounded overflow-hidden shadow-sm" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @{ var first = true; }
                        @foreach (var img in Model.Images)
                        {
                            <div class="carousel-item @(first ? "active" : null)">
                                <img src="@img.Url" class="d-block w-100" alt="@Model.Title"
                                     style="height: 420px; object-fit: cover;" />
                            </div>
                            first = false;
                        }
                    </div>
                    @if (Model.Images.Count > 1)
                    {
                        <div class="carousel-indicators">
                            @for (int i = 0; i < Model.Images.Count; i++)
                            {
                                <button type="button" data-bs-target="#bookCarousel" data-bs-slide-to="@i"
                                        class="@(i == 0 ? "active" : null)" aria-label="Фото @(i + 1)"></button>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#bookCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Назад</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#bookCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Вперед</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="bg-light text-muted d-flex align-items-center justify-content-center rounded" style="height: 420px;">
                    Немає обкладинки
                </div>
            }
        </div>
        <div class="col-md-8">
            <span class="badge rounded-pill text-bg-secondary mb-2">@Model.Genre</span>
            <h1 class="fw-bold">@Model.Title</h1>
            <p class="lead text-muted mb-3">@Model.Author</p>
            <h3 class="text-success fw-bold">@Model.Price.ToString("0.00") грн</h3>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            @await Component.InvokeAsync("Comments", new { bookId = Model.Id })
        </div>
    </div>
</div>
