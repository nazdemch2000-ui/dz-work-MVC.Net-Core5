@model MVC_Dz5.Models.Book
@{
    ViewData["Title"] = "Видалити книгу";
}

<div class="container py-4" style="max-width: 560px;">
    <h1 class="fw-bold mb-4">Видалити книгу?</h1>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <span class="badge rounded-pill text-bg-secondary mb-2">@Model.Genre</span>
            <h5 class="mb-1">@Model.Title</h5>
            <p class="text-muted mb-2">@Model.Author</p>
            <p class="fw-bold text-success mb-0">@Model.Price.ToString("0.00") грн</p>
        </div>
    </div>

    <div class="alert alert-warning">
        Разом з книгою будуть видалені всі її коментарі та зображення.
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Видалити</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Скасувати</a>
    </form>
</div>
